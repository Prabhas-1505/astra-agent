OPENAI_API_KEY=

# Required to run against the lab (host-venv flow, Option A in the README).
# This is the fake routers' own fixture credential (lab/fake_router/server.py),
# not a real device credential — netmiko_tool.py has no source-code default on
# purpose, so these must be set explicitly rather than silently assumed.
ROUTER_USER=netops
ROUTER_PASS=C1sco123!

# Optional: DEBUG/INFO/WARNING/ERROR. Defaults to INFO. DEBUG also logs every
# raw syslog packet received by app/triggers/syslog_listener.py.
ASTRA_LOG_LEVEL=

# Optional: set these three to get full LangSmith tracing of every graph run
# (hypothesis prompts, validation verdicts, token usage, latency per node) with
# zero code changes — langchain-core reads them automatically. Get an API key at
# https://smith.langchain.com.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=astra-agent
